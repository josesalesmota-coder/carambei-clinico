{"code":"PC-PA-CAR-012","sourceUrl":"https://docs.google.com/document/d/1z5ag104p5ZbgmOaE2ov0h1q4zhcrHqVJ/edit?usp=drivesdk&ouid=114075849526533350220&rtpof=true&sd=true","sourceTitle":"PC-PA-CAR-012_Exacerbacao_Aguda_Asma_v1.0.docx","modifiedAt":"2026-09-28T13:34:05.300Z","importedAt":"2026-09-28","version":"1.0","sha256":"2ddfd7b77ada167971dd9d74f07f698a2d4b7f3949b1daf173879de7cca5ff81","blocks":[{"type":"paragraph","text":"EXACERBAÇÃO AGUDA DE ASMA","level":0,"list":false},{"type":"paragraph","text":"ELABORAÇÃO E APROVAÇÃO INSTITUCIONAL","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"FUNÇÃO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"NOME / REGISTRO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"ASSINATURA","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"DATA","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Autor do protocolo","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. José Augusto Sales da Mota","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 55219","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Médico Responsável Técnico","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. Carlos Alexandre Fernandes","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 12678","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Diretor Clínico","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. José Augusto Sales da Mota","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 55219","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Secretária Municipal de Saúde","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Maira Martins de Hollemben","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Responsável Técnica da Enfermagem","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Patricia Manfre de Toledo\nCOREN-PR 203032","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}]]},{"type":"paragraph","text":"Protocolo institucional aprovado.","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"PRINCÍPIO OPERACIONAL DE CARAMBEÍ\nEste protocolo foi adaptado à realidade do Pronto Atendimento de Carambeí, considerando a REMUME 2026, o checklist do carrinho de emergência, a possibilidade de TC e ultrassonografia no mesmo dia e a necessidade de regulação precoce nas condições tempo-dependentes. A realização de exame local não deve atrasar transferência quando o benefício do tratamento definitivo depende de tempo.","level":0,"list":false}]}]]},{"type":"paragraph","text":"Abrangência: adultos, adolescentes e crianças com exacerbação aguda de asma","level":0,"list":false},{"type":"paragraph","text":"Status: protocolo revisado e aprovado pela Direção Clínica e pela Direção Técnica.","level":0,"list":false},{"type":"heading","text":"1. Gravidade","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Achado","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Leve/moderada","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Grave / ameaça à vida","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Fala","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Frases","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Palavras, incapacidade de falar, silêncio","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Trabalho respiratório","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Aumentado, sem exaustão","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Uso intenso de musculatura, fadiga, tórax silencioso","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"SpO2","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Geralmente >=93%","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"<90-92% ou queda progressiva","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Estado mental","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Normal","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Agitação, confusão, sonolência","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"PEF, se disponível","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":">50% previsto/melhor pessoal","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"<=50%; ameaça à vida se muito baixo/incapaz de realizar","level":0,"list":false}]}]]},{"type":"heading","text":"2. Tratamento da primeira hora","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Terapia","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Adulto/adolescente","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Criança","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Salbutamol MDI + espaçador","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"4-10 jatos (100 mcg/jato) a cada 20 min na primeira hora; depois conforme resposta","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"4-10 jatos a cada 20 min na primeira hora, ajustando por idade/técnica","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Ipratrópio - grave","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"0,5 mg nebulizado a cada 20 min por 3 doses (solução 0,25 mg/mL = 2 mL por dose), se nebulizador disponível","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"0,25-0,5 mg por dose conforme idade/peso e protocolo pediátrico","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Corticoide sistêmico","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Prednisona/prednisolona 40-50 mg VO/dia por 5-7 dias","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Prednisolona 1-2 mg/kg/dia (máx. 40 mg) por 3-5 dias","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Oxigênio","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Titular para SpO2 93-95%","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Alvo geralmente 94-98%","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Magnésio EV - grave/refratária","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Sulfato de magnésio 2 g EV em 20 min, dose única","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"25-50 mg/kg (máx. 2 g) EV em 20-30 min, conforme protocolo pediátrico","level":0,"list":false}]}]]},{"type":"heading","text":"3. O que evitar","level":2,"list":false},{"type":"paragraph","text":"Aminofilina/metilxantinas não são recomendadas rotineiramente na exacerbação aguda devido a baixa relação benefício-risco, apesar de existir aminofilina no carrinho.","level":0,"list":false},{"type":"paragraph","text":"Antibiótico não é indicado sem evidência de infecção bacteriana. Adrenalina IM não é tratamento rotineiro da exacerbação isolada; administrar prontamente se houver anafilaxia, angioedema ou outra indicação específica.","level":0,"list":false},{"type":"paragraph","text":"Sedativos devem ser evitados em paciente não intubado com crise grave.","level":0,"list":false},{"type":"paragraph","text":"Não atrasar IOT quando houver exaustão, rebaixamento, hipercapnia progressiva com acidose ou tórax silencioso com piora.","level":0,"list":false},{"type":"heading","text":"4. IOT na asma","level":2,"list":false},{"type":"paragraph","text":"IOT é procedimento de alto risco; usar protocolo de IOT segura.","level":0,"list":false},{"type":"paragraph","text":"Após intubação: baixo volume corrente, frequência reduzida, fluxo inspiratório alto e tempo expiratório prolongado para reduzir auto-PEEP; aceitar hipercapnia permissiva quando hemodinamicamente tolerada.","level":0,"list":false},{"type":"paragraph","text":"Escetamina pode ser indutor útil por efeito broncodilatador, respeitando dose e hemodinâmica.","level":0,"list":false},{"type":"heading","text":"5. Alta e prevenção","level":2,"list":false},{"type":"paragraph","text":"Alta apenas após resposta sustentada, fala/conforto adequados, SpO2 estável e redução da necessidade de SABA.","level":0,"list":false},{"type":"paragraph","text":"Todo paciente deve sair com terapia contendo corticoide inalatório (ICS). A REMUME dispõe de beclometasona; orientar técnica e adesão.","level":0,"list":false},{"type":"paragraph","text":"Revisão em 2-7 dias após exacerbação; orientar plano de ação e sinais de retorno.","level":0,"list":false},{"type":"heading","text":"Algoritmo operacional resumido","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"1","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Avaliar gravidade + SpO2 + fala + esforço respiratório","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"2","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Salbutamol repetido + O2 se necessário + corticoide precoce","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"3","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Grave -> ipratrópio + Mg EV + reavaliação contínua","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"4","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Falha/exaustão -> IOT segura + transferência; melhora -> alta com ICS e seguimento","level":0,"list":false}]}]]},{"type":"heading","text":"Referências e bases técnicas","level":2,"list":false},{"type":"paragraph","text":"1. Global Initiative for Asthma (GINA). Global Strategy for Asthma Management and Prevention, 2026.","level":0,"list":false},{"type":"paragraph","text":"2. SAMU/UPA. Emergências Respiratórias, v.2, 25/06/2024 (base estrutural local).","level":0,"list":false},{"type":"paragraph","text":"3. REMUME Carambeí 2026 e Checklist do Carrinho de Emergência do CMS.","level":0,"list":false},{"type":"paragraph","text":"Controle de versão — v1.0, 20/09/2026: primeira versão institucional; criticidade alto; aprovado institucionalmente.","level":0,"list":false},{"type":"paragraph","text":"FLUXOGRAMA ASSISTENCIAL NO PRONTO ATENDIMENTO","level":0,"list":false},{"type":"image","src":"./protocolos/images/d06ba25171b99137198f.png","alt":"Imagem do protocolo PC-PA-CAR-012"},{"type":"paragraph","text":"Fluxograma padronizado do manejo no PA/CMS de Carambeí","level":0,"list":false},{"type":"paragraph","text":"FLUXOGRAMA DE CONSULTAS E DESTINO FINAL","level":0,"list":false},{"type":"image","src":"./protocolos/images/1d4122e76a9084d8bab2.png","alt":"Imagem do protocolo PC-PA-CAR-012"},{"type":"paragraph","text":"Definição prática de consultas, regulação e destino final do paciente","level":0,"list":false},{"type":"paragrap