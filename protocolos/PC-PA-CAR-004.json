{"code":"PC-PA-CAR-004","sourceUrl":"https://docs.google.com/document/d/15y9yWne6Gut8Ht0En2Co_JAc3vdMGjC1/edit?usp=drivesdk&ouid=114075849526533350220&rtpof=true&sd=true","sourceTitle":"PC-PA-CAR-004_COVID_e_Sindromes_Respiratorias_v1.0.docx","modifiedAt":"2026-09-28T13:33:06.450Z","importedAt":"2026-09-28","version":"1.0","sha256":"c87ec8388b58b1b7005a375e12ca875b664c553548057fc17a990b60bb592631","blocks":[{"type":"paragraph","text":"COVID-19 E OUTRAS SÍNDROMES RESPIRATÓRIAS","level":0,"list":false},{"type":"paragraph","text":"ELABORAÇÃO E APROVAÇÃO INSTITUCIONAL","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"FUNÇÃO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"NOME / REGISTRO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"ASSINATURA","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"DATA","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Autor do protocolo","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. José Augusto Sales da Mota","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 55219","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Médico Responsável Técnico","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. Carlos Alexandre Fernandes","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 12678","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Diretor Clínico","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dr. José Augusto Sales da Mota","level":0,"list":false},{"type":"paragraph","text":"CRM-PR 55219","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Secretária Municipal de Saúde","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Maira Martins de Hollemben","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Responsável Técnica da Enfermagem","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Patricia Manfre de Toledo\nCOREN-PR 203032","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[{"type":"paragraph","text":"____/____/______","level":0,"list":false}]}]]},{"type":"paragraph","text":"Protocolo institucional aprovado.","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"PRINCÍPIO OPERACIONAL DE CARAMBEÍ\nEste protocolo foi adaptado à realidade do Pronto Atendimento de Carambeí, considerando a REMUME 2026, o checklist do carrinho de emergência, a possibilidade de TC e ultrassonografia no mesmo dia e a necessidade de regulação precoce nas condições tempo-dependentes. A realização de exame local não deve atrasar transferência quando o benefício do tratamento definitivo depende de tempo.","level":0,"list":false}]}]]},{"type":"paragraph","text":"Abrangência: adultos e crianças com síndrome gripal, COVID-19, influenza, pneumonia, SRAG ou insuficiência respiratória aguda","level":0,"list":false},{"type":"paragraph","text":"Status: protocolo revisado e aprovado pela Direção Clínica e pela Direção Técnica.","level":0,"list":false},{"type":"heading","text":"1. Classificação sindrômica","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Síndrome","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Critérios práticos","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Síndrome gripal (SG)","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Quadro agudo com febre ou sensação febril, tosse, dor de garganta, coriza, cefaleia/mialgia, sem sinais de gravidade.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"SRAG / insuficiência respiratória","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"SG associada a dispneia, desconforto respiratório, hipoxemia, piora clínica, cianose, alteração mental ou necessidade de suporte ventilatório.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Pneumonia","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Sintomas respiratórios + achados focais/crepitações ou imagem compatível; avaliar etiologia viral, bacteriana e aspiração.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"COVID-19","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Confirmar por teste quando indicado, sem retardar suporte. Gravidade é definida principalmente por hipoxemia, esforço respiratório e disfunção orgânica.","level":0,"list":false}]}]]},{"type":"heading","text":"2. Sinais de gravidade e destino","level":2,"list":false},{"type":"paragraph","text":"SpO2 persistentemente <94% em ar ambiente (avaliar basal e contexto; em DPOC, metas específicas 88-92%).","level":0,"list":false},{"type":"paragraph","text":"Em adultos: FR >30 irpm. Em crianças, avaliar frequência respiratória conforme a idade. Em qualquer idade, fala entrecortada, uso intenso de musculatura acessória, fadiga, cianose ou alteração do nível de consciência são sinais de gravidade.","level":0,"list":false},{"type":"paragraph","text":"Em adultos: PAS <90 mmHg. Em crianças, usar limites de pressão arterial adequados à idade. Sinais de choque, lactato elevado ou disfunção orgânica exigem abordagem imediata em qualquer idade.","level":0,"list":false},{"type":"paragraph","text":"Necessidade de VNI, alto fluxo, IOT ou oxigênio crescente -> regulação hospitalar imediata.","level":0,"list":false},{"type":"heading","text":"3. Abordagem inicial","level":2,"list":false},{"type":"paragraph","text":"Precaução respiratória conforme agente suspeito, higiene de mãos, máscara no paciente quando tolerada e EPI da equipe conforme risco de aerossol.","level":0,"list":false},{"type":"paragraph","text":"Monitorização, acesso venoso se moderado/grave, glicemia, avaliação do trabalho respiratório e hidratação.","level":0,"list":false},{"type":"paragraph","text":"Oxigênio titulado: alvo usual 92-96%; em DPOC/retentores crônicos, 88-92%.","level":0,"list":false},{"type":"paragraph","text":"Radiografia de tórax e exames laboratoriais conforme gravidade. US pulmonar pode auxiliar quando disponível.","level":0,"list":false},{"type":"paragraph","text":"Escalonar suporte: cateter/máscara -> VNI/HFNO se disponível e indicado -> IOT se falência/contraindicação.","level":0,"list":false},{"type":"heading","text":"4. Influenza - oseltamivir","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Cenário","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Conduta","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"SG com fator de risco para complicação","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Oseltamivir o mais precocemente possível, preferencialmente nas primeiras 48 h, independentemente da situação vacinal.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"SRAG ou sinais de agravamento","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Iniciar oseltamivir imediatamente; benefício pode existir mesmo quando iniciado após 48 h. Adulto: 75 mg VO 12/12 h por 5 dias, com ajuste renal.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Criança","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Dose por peso/idade conforme protocolo do Ministério da Saúde. O estoque informado tem 45 e 75 mg, com falta de 30 mg; verificar formulação adequada antes da prescrição pediátrica.","level":0,"list":false}]}]]},{"type":"heading","text":"5. COVID-19","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Gravidade","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Conduta no PA","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Não grave, sem hipoxemia","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Sintomáticos, hidratação, orientação de isolamento/controle de transmissão conforme norma vigente. Não usar corticoide sistêmico de rotina. Não usar antibiótico empírico se baixa suspeita de coinfecção bacteriana.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Não grave, alto risco para progressão","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Avaliar elegibilidade para antiviral específico do SUS (ex.: nirmatrelvir/ritonavir conforme protocolo vigente). O medicamento não foi identificado na lista de estoque do PA; articular rede/dispensação sem atraso.","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"Grave/crítico com necessidade de O2","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"Suporte respiratório + dexametasona 6 mg/dia VO/EV (ou equivalente: prednisona 40 mg/dia ou metilprednisolona 32 mg/dia) por até 10 dias ou até alta, se não houver contraindicação. Transferência hospitalar. As doses fixas acima são adultas. Em crianças, a indicação e a dose por peso exigem avaliação e protocolo pediátrico específico; não aplicar automaticamente as doses adultas.","level":0,"list":false}]}]]},{"type":"heading","text":"6. Suspeita de pneumonia bacteriana","level":2,"list":false},{"type":"paragraph","text":"Não prescrever antibiótico apenas por COVID/influenza confirmado sem evidência clínica de coinfecção bacteriana.","level":0,"list":false},{"type":"paragraph","text":"Em pneumonia comunitária moderada/grave: ceftriaxona parenteral + azitromicina é opção compatível com o estoque informado, desde que a via da ceftriaxona disponível seja confirmada.","level":0,"list":false},{"type":"paragraph","text":"Choque, necessidade de ventilação, imunossupressão, aspiração importante ou risco de germes resistentes -> transferência e antibiótico ampliado conforme serviço receptor.","level":0,"list":false},{"type":"heading","text":"7. Critérios de alta","level":2,"list":false},{"type":"paragraph","text":"Sem hipoxemia em ar ambiente no contexto basal, sem esforço respiratório relevante, estabilidade hemodinâmica e capacidade de hidratação/medicação oral.","level":0,"list":false},{"type":"paragraph","text":"Orientar retorno imediato por dispneia, dor torácica, confusão, cianose, desidratação, febre persistente/piora ou queda de saturação.","level":0,"list":false},{"type":"paragraph","text":"Notificação de SRAG e demais agravos conforme Vigilância Epidemiológica vigente.","level":0,"list":false},{"type":"heading","text":"Algoritmo operacional resumido","level":2,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"1","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"SG -> avaliar fatores de risco e sinais de agravamento","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"2","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"SRAG/hipoxemia -> O2 + suporte + oseltamivir se influenza possível + regulação","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"3","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"COVID sem O2 -> suporte; sem corticoide/antibiótico rotineiros","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"4","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"COVID grave com O2 -> corticoide sistêmico + transferência","level":0,"list":false}]}]]},{"type":"heading","text":"Referências e bases técnicas","level":2,"list":false},{"type":"paragraph","text":"1. Ministério da Saúde. Guia de Vigilância Integrada da Covid-19, Influenza e Outros Vírus Respiratórios de Importância em Saúde Pública, 2024 (documento oficial vigente consultado em 2026).","level":0,"list":false},{"type":"paragraph","text":"2. WHO. Clinical management of COVID-19: living guideline, June 2025; Therapeutics and COVID-19 living guideline, 2025.","level":0,"list":false},{"type":"paragraph","text":"3. SAMU/UPA. Emergências Respiratórias - Fluxo de Atendimento nas UPA, v.2, 25/06/2024 (base estrutural local).","level":0,"list":false},{"type":"paragraph","text":"4. REMUME Carambeí 2026 e Checklist de Medicamentos do Carrinho de Emergência do CMS.","level":0,"list":false},{"type":"paragraph","text":"Controle de versão — v1.0, 20/09/2026: primeira versão institucional; criticidade alto; aprovado institucionalmente.","level":0,"list":false},{"type":"paragraph","text":"FLUXOGRAMA ASSISTENCIAL NO PRONTO ATENDIMENTO","level":0,"list":false},{"type":"image","src":"./protocolos/images/df065849bad75e9adcd4.png","alt":"Imagem do protocolo PC-PA-CAR-004"},{"type":"paragraph","text":"Fluxograma padronizado do manejo no PA/CMS de Carambeí","level":0,"list":false},{"type":"paragraph","text":"FLUXOGRAMA DE CONSULTAS E DESTINO FINAL","level":0,"list":false},{"type":"image","src":"./protocolos/images/cd9cc949365637b89226.png","alt":"Imagem do protocolo PC-PA-CAR-004"},{"type":"paragraph","text":"Definição prática de consultas, regulação e destino final do paciente","level":0,"list":false},{"type":"paragraph","text":"TERMO DE CIÊNCIA E CONCORDÂNCIA - CORPO MÉDICO DO CMS","level":0,"list":false},{"type":"paragraph","text":"Os médicos abaixo declaram ciência do conteúdo deste protocolo institucional e registram sua concordância com o fluxo assistencial proposto, sem prejuízo do julgamento clínico individual e das particularidades de cada paciente.","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Nº","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"NOME DO MÉDICO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"CRM-PR","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"ASSINATURA / DATA","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"1","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"2","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"3","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"4","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"5","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"6","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"7","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"8","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"9","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"10","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"11","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"12","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"13","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"14","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"15","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"16","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}]]},{"type":"paragraph","text":"TERMO DE CIÊNCIA E CONCORDÂNCIA - CORPO MÉDICO DO CMS","level":0,"list":false},{"type":"paragraph","text":"Continuação","level":0,"list":false},{"type":"table","rows":[[{"span":1,"blocks":[{"type":"paragraph","text":"Nº","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"NOME DO MÉDICO","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"CRM-PR","level":0,"list":false}]},{"span":1,"blocks":[{"type":"paragraph","text":"ASSINATURA / DATA","level":0,"list":false}]}],[{"span":1,"blocks":[{"type":"paragraph","text":"17","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"18","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"19","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"20","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"21","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"22","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"23","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"24","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"25","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"26","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"27","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"28","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"29","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"30","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"31","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}],[{"span":1,"blocks":[{"type":"paragraph","text":"32","level":0,"list":false}]},{"span":1,"blocks":[]},{"span":1,"blocks":[]},{"span":1,"blocks":[]}]]}],"siteRevision":{"date":"23/09/2026","notes":["Identificadas as doses fixas de corticoides e os limites de FR/PAS como referências adultas, evitando aplicação automática em crianças."],"sources":[{"label":"IDSA · tratamento da COVID-19","url":"https://www.idsociety.org/practice-guideline/covid-19-guideline-treatment-and-management/"}],"sourceSha256":"c87ec8388b58b1b7005a375e12ca875b664c553548057fc17a990b60bb592631"},"institutionalStatus":{"status":"approved","confirmedOn":"2026-09-27","approvedBy":["Direção Clínica","Direção Técnica"]}}